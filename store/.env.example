# ============================================================
# AxTBot 插件商店 · 站点配置（示例）
# 复制为 .env 后按需修改；修改后需重启 dev server
# ============================================================

# ---------- 站点文案 ----------

# 标题栏主标题（也用于浏览器标签页）
VITE_SITE_TITLE=AxTBot 插件商店

# 标题栏副标题
VITE_SITE_SUBTITLE=发现、浏览与提交 AxTBot 插件

# 标题栏 Logo：填图片 URL 则显示该图片；留空使用默认机器人图标
VITE_SITE_LOGO=

# 标题栏 Logo 右上角小徽章文字（如 "AxTBot"）；留空则不显示
VITE_SITE_BADGE=

# 页脚左侧文案
VITE_FOOTER_LEFT=© 2026 AxT-Team. All rights reserved.

# 页脚右侧文案，支持 [文字](链接) 形式（可写多个）
VITE_FOOTER_RIGHT=[GitHub](https://github.com/AxT-Team/AxTBot-PluginStore)

# ---------- 数据源 ----------

# 存放插件元数据的 GitHub 仓库（提交插件时也会跳转到该仓库的 issue）
VITE_GITHUB_OWNER=AxT-Team
VITE_GITHUB_REPO=AxTBot-PluginStore
VITE_GITHUB_BRANCH=main

# assess 目录名（存放插件元数据 JSON 与总索引 index.json）
VITE_ASSESS_DIR=assess

# 可选：完全自定义数据源根 URL。
# 设置后插件数据从此地址读取（拼接 /index.json、/axtbot-plugin-xxx.json），
# 可指向镜像、CDN 或自建服务，将忽略上面的 GitHub 配置。
# 留空则使用：GitHub raw（生产） / 本地 assess（开发）
# VITE_ASSESS_BASE_URL=https://example.com/plugin-mirror
